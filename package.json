{
  "name": "quarry-studio",
  "productName": "Quarry Studio",
  "version": "1.0.0",
  "description": "A modern multi-database SQL editor and database manager",
  "main": "./out/main/index.js",
  "author": "Ahmed Milad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmedMilad/quarry-studio.git"
  },
  "homepage": "https://github.com/AhmedMilad/quarry-studio#readme",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:watch": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "postinstall": "electron-rebuild -f -o better-sqlite3",
    "dist": "electron-vite build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "app.quarrystudio",
    "productName": "Quarry Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "resources/icon.png",
      "executableName": "quarry-studio",
      "synopsis": "Multi-database SQL editor"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "exceljs": "4.4.0",
    "mssql": "^11.0.2",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "ssh2": "~1.16.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@monaco-editor/react": "4.7.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "35.7.5",
    "electron-builder": "^26.18.0",
    "electron-vite": "3.1.0",
    "lucide-react": "0.468.0",
    "monaco-editor": "0.52.2",
    "react": "18.3.1",
    "react-data-grid": "7.0.0-beta.47",
    "react-dom": "18.3.1",
    "sql-formatter": "^15.9.1",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "3.2.4",
    "zustand": "5.0.16"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3",
      "esbuild"
    ]
  }
}
